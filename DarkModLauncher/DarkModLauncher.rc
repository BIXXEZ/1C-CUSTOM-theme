#include "DarkModResource.h"

//
// The DLL is referenced by bare file name on purpose. rc.exe
// resolves it through its include path, and the project passes
// /i $(OutDir), so the same line works for Debug and Release
// without naming a configuration here.
//
// DarkMod.sln declares DarkModLauncher as dependent on
// DarkModDLL, so the file exists by the time rc.exe runs.
//

IDR_DARKMOD_DLL RCDATA "DarkModDLL.dll"
